# Bundler
/.bundle
/vendor/bundle

# Environment
.env
.env.*
!.env.example
/config/credentials/*.key
/config/master.key

# Logs and temp files
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
!/tmp/pids/.keep
!/tmp/cache/.keep
!/tmp/sockets/.keep

# Database
/db/*.sqlite3
/db/*.sqlite3-*

# Assets
/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep

# Storage
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Node
/node_modules

# macOS
.DS_Store

# IDE
.idea/
.vscode/
*.swp
*.swo

# Bootsnap cache
/tmp/cache/bootsnap*

# Test coverage
/coverage

# Kamal
.kamal/
